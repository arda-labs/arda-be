# External PostgreSQL credentials
# Create these databases and users on your own Postgres instance, then copy this file to .env
# Local auth-gateway dotenv loading is opt-in: ARDA_LOAD_DOTENV=true

# IAM database
IAM_DATABASE_HOST=localhost
IAM_DATABASE_PORT=5432
IAM_DATABASE_USER=iam_user
IAM_DATABASE_PASSWORD=
IAM_DATABASE_NAME=iam
IAM_DATABASE_SSLMODE=disable

# Shared application database (platform-service)
COMMON_DATABASE_HOST=localhost
COMMON_DATABASE_PORT=5432
COMMON_DATABASE_USER=
COMMON_DATABASE_PASSWORD=
COMMON_DATABASE_NAME=common
COMMON_DATABASE_SSLMODE=disable

# Media database
MEDIA_DATABASE_HOST=localhost
MEDIA_DATABASE_PORT=5432
MEDIA_DATABASE_USER=
MEDIA_DATABASE_PASSWORD=
MEDIA_DATABASE_NAME=media
MEDIA_DATABASE_SSLMODE=disable

# Workflow database
WORKFLOW_DATABASE_HOST=localhost
WORKFLOW_DATABASE_PORT=5432
WORKFLOW_DATABASE_USER=
WORKFLOW_DATABASE_PASSWORD=
WORKFLOW_DATABASE_SSLMODE=disable

# CRM database
CRM_DATABASE_HOST=localhost
CRM_DATABASE_PORT=5432
CRM_DATABASE_USER=
CRM_DATABASE_PASSWORD=
CRM_DATABASE_SSLMODE=disable

# HRM database
HRM_DATABASE_HOST=localhost
HRM_DATABASE_PORT=5432
HRM_DATABASE_USER=
HRM_DATABASE_PASSWORD=
HRM_DATABASE_SSLMODE=disable

# Notification database
NOTIFICATION_DATABASE_HOST=localhost
NOTIFICATION_DATABASE_PORT=5432
NOTIFICATION_DATABASE_USER=
NOTIFICATION_DATABASE_PASSWORD=
NOTIFICATION_DATABASE_SSLMODE=disable

# Hydra database
HYDRA_DATABASE_HOST=localhost
HYDRA_DATABASE_PORT=5432
HYDRA_DATABASE_USER=hydra_user
HYDRA_DATABASE_PASSWORD=
HYDRA_DATABASE_NAME=hydra
HYDRA_DATABASE_SSLMODE=disable

# Auth gateway introspection client (must match Hydra client created by hydra-seed job)
INTROSPECTION_CLIENT_ID=auth-gateway
INTROSPECTION_CLIENT_SECRET=

# Mock token dev secret
JWT_SECRET=

# Session store mode is explicit. Use memory only for local development;
# production and shared environments must use redis.
SESSION_STORE=memory
REDIS_URL=

# Shared workload identity secret for internal gRPC calls (minimum 32 chars).
# Keep this only in local .env/secret manager; never commit the real value.
ARDA_SERVICE_AUTH_SECRET=

# Internal gRPC mTLS files. Generate per-service certificates from one local CA
# using the runbook in docs/refactor-program/09-mtls-runbook.md.
ARDA_GRPC_CA_FILE=/var/run/arda-grpc-tls/ca.crt
ARDA_GRPC_CERT_FILE=/var/run/arda-grpc-tls/tls.crt
ARDA_GRPC_KEY_FILE=/var/run/arda-grpc-tls/tls.key

# Dev dependencies (k3s LAN or port-forward). The committed configs default to
# the kubectl port-forwards in docs/dev/dependencies.md, which are the values
# below. To run scripts/dev.ps1 against LAN NodePorts instead, put these keys
# in .env.local (dev.ps1 loads it; docker compose does not) with the values
# from arda-infra/dev/endpoints.example.env. Keep them out of .env: compose
# reads it and containers need host.docker.internal, not localhost.
# NATS_URL=nats://localhost:4222
# ZEEBE_ADDR=localhost:26500
# ZEEBE_REST_ADDR=http://localhost:18080
# HYDRA_ADMIN_URL=http://localhost:4445
# KRATOS_ADMIN_URL=http://localhost:4434

# Garage/S3 credentials (create a key with arda-infra/platform/bootstrap/init-garage.sh)
STORAGE_ENDPOINT=https://s3.arda.io.vn

# Garage/S3 credentials (create a key with arda-infra/platform/bootstrap/init-garage.sh)
STORAGE_ENDPOINT=https://s3.arda.io.vn
STORAGE_REGION=garage
STORAGE_BUCKET=media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=true

# AI service. Nothing reads this key directly: run ai-service with
# DATABASE_DSN set to this value for persistent storage (AI_MODE=production
# requires it; development mode falls back to memory).
AI_DATABASE_DSN=

# Model-driven agent loop (optional). The provider must speak the
# OpenAI-compatible chat-completions SSE protocol; a local vLLM/Ollama URL
# works without an API key.
AI_ENABLE_AGENT=false
AI_MODEL_BASE_URL=https://api.openai.com/v1
AI_MODEL_API_KEY=
AI_MODEL_ID=

# Optional OpenAI-compatible embedding provider. This is deliberately separate
# from the chat model; production ingestion fails closed when it is unset.
AI_RAG_EMBEDDING_BASE_URL=
AI_RAG_EMBEDDING_API_KEY=
AI_RAG_EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
AI_RAG_EMBEDDING_DIMENSIONS=1024
