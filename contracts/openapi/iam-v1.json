{
  "openapi": "3.1.0",
  "info": {
    "title": "Arda IAM API",
    "version": "1.0.0"
  },
  "servers": [{ "url": "https://api.arda.io.vn" }],
  "security": [{ "ardaSession": [] }],
  "paths": {
    "/api/admin/permissions": {
      "get": {
        "operationId": "listAdminPermissions",
        "summary": "List permissions",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" },
          {
            "name": "module",
            "in": "query",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical paginated permission list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PermissionListSuccess"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "500": { "$ref": "#/components/responses/Problem" }
        }
      },
      "post": {
        "operationId": "createAdminPermission",
        "summary": "Create a permission",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePermissionRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created permission",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PermissionSuccess" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "409": { "$ref": "#/components/responses/Problem" }
        }
      }
    },
    "/api/admin/permissions/{id}": {
      "delete": {
        "operationId": "deleteAdminPermission",
        "summary": "Delete a permission",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Deleted permission",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/StatusSuccess" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Problem" },
          "401": { "$ref": "#/components/responses/Problem" },
          "403": { "$ref": "#/components/responses/Problem" },
          "404": { "$ref": "#/components/responses/Problem" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ardaSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "arda_sid",
        "x-browser-credentials": "include"
      }
    },
    "parameters": {
      "Page": {
        "name": "page",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "default": 1 }
      },
      "PerPage": {
        "name": "per_page",
        "in": "query",
        "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
      }
    },
    "schemas": {
      "ResponseMeta": {
        "type": "object",
        "required": ["request_id"],
        "properties": {
          "request_id": { "type": "string" },
          "trace_id": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "Permission": {
        "type": "object",
        "required": ["id", "code", "name", "module", "resource", "operation"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "module": { "type": "string" },
          "resource": { "type": "string" },
          "operation": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "ListResult": {
        "type": "object",
        "required": ["items", "page", "per_page", "total"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/Permission" } },
          "page": { "type": "integer", "minimum": 1 },
          "per_page": { "type": "integer", "minimum": 1, "maximum": 100 },
          "total": { "type": "integer", "minimum": 0 }
        }
      },
      "PermissionListSuccess": {
        "type": "object",
        "required": ["result", "success", "errors", "messages", "meta"],
        "properties": {
          "result": { "$ref": "#/components/schemas/ListResult" },
          "success": { "const": true },
          "errors": { "type": "array", "maxItems": 0 },
          "messages": { "type": "array", "items": { "type": "string" } },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        }
      },
      "PermissionSuccess": {
        "type": "object",
        "required": ["result", "success", "errors", "messages", "meta"],
        "properties": {
          "result": { "$ref": "#/components/schemas/Permission" },
          "success": { "const": true },
          "errors": { "type": "array", "maxItems": 0 },
          "messages": { "type": "array", "items": { "type": "string" } },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        }
      },
      "StatusSuccess": {
        "type": "object",
        "required": ["result", "success", "errors", "messages", "meta"],
        "properties": {
          "result": {
            "type": "object",
            "required": ["status"],
            "properties": { "status": { "const": "deleted" } }
          },
          "success": { "const": true },
          "errors": { "type": "array", "maxItems": 0 },
          "messages": { "type": "array", "items": { "type": "string" } },
          "meta": { "$ref": "#/components/schemas/ResponseMeta" }
        }
      },
      "CreatePermissionRequest": {
        "type": "object",
        "required": ["code", "module", "resource", "operation"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "module": { "type": "string", "minLength": 1 },
          "resource": { "type": "string", "minLength": 1 },
          "operation": { "type": "string", "minLength": 1 }
        }
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status", "code", "message"],
        "properties": {
          "type": { "type": "string", "format": "uri-reference" },
          "title": { "type": "string" },
          "status": { "type": "integer" },
          "code": { "type": "string" },
          "message": { "type": "string" },
          "errors": { "type": "array", "items": { "$ref": "#/components/schemas/ProblemError" } },
          "request_id": { "type": "string" },
          "trace_id": { "type": "string" }
        }
      },
      "ProblemError": {
        "type": "object",
        "required": ["message"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "field": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "RFC-style problem response",
        "content": {
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Problem" }
          }
        }
      }
    }
  }
}
