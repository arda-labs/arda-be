{
  "openapi": "3.1.0",
  "info": {
    "title": "Arda Platform internal AI surface",
    "version": "1.0.0",
    "description": "Operations the Platform service exposes to ai-service on /internal/ai/*. Signed service-to-service transport; the delegated tenant is taken from the X-Tenant-Id header forwarded by ai-service, never from tool arguments. Parameters marked is_secret are filtered out by the handler, so Parameter.value never leaves the service."
  },
  "paths": {
    "/internal/ai/organizations": {
      "get": {
        "operationId": "aiListOrganizations",
        "summary": "List organizations in the delegated tenant.",
        "description": "List organizations of the active tenant, optionally filtered by a free-text query on code/name. Returns id, code, name, parentId, parentName and isActive per organization, with pagination.",
        "x-ai-tool": {
          "sdkPath": "arda.platform.listOrganizations",
          "domain": "platform",
          "kind": "read",
          "risk": "low",
          "timeoutMs": 3000,
          "keywords": [
            "platform",
            "organization",
            "organizations",
            "org unit",
            "org chart",
            "list",
            "search",
            "tổ chức",
            "cơ cấu tổ chức",
            "đơn vị",
            "phòng ban",
            "liệt kê tổ chức"
          ],
          "requiredPerms": [
            "platform.read"
          ],
          "service": "platform-service",
          "envelope": "result",
          "returns": "OrganizationListPage { items: [{ id, code, name, parentId, parentName, isActive }], page, per_page, total }"
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "x-ai-arg": "search",
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Free-text filter on organization code/name"
          },
          {
            "name": "page",
            "in": "query",
            "x-ai-arg": "page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "One-based page number"
          },
          {
            "name": "per_page",
            "in": "query",
            "x-ai-arg": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 20
            },
            "description": "Page size, 1-20"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted paginated organization page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AiOrganization"
                          }
                        },
                        "page": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/ai/parameters": {
      "get": {
        "operationId": "aiListParameters",
        "summary": "List tenant parameters (secrets excluded).",
        "description": "List configuration parameters of the active tenant, optionally filtered by scope type. Rows marked is_secret are never returned, so Parameter.value only appears for non-secret parameters.",
        "x-ai-tool": {
          "sdkPath": "arda.platform.listParameters",
          "domain": "platform",
          "kind": "read",
          "risk": "low",
          "timeoutMs": 3000,
          "keywords": [
            "platform",
            "parameter",
            "parameters",
            "setting",
            "settings",
            "config",
            "tham số",
            "cấu hình",
            "thiết lập",
            "liệt kê tham số"
          ],
          "requiredPerms": [
            "platform.read"
          ],
          "service": "platform-service",
          "envelope": "result",
          "returns": "ParameterList { items: [{ id, key, value, valueType, scopeType, description }] }"
        },
        "parameters": [
          {
            "name": "scope_type",
            "in": "query",
            "x-ai-arg": "scopeType",
            "schema": {
              "type": "string",
              "enum": [
                "global",
                "tenant",
                "org",
                "branch",
                "department"
              ]
            },
            "description": "Optional filter by parameter scope type"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted parameter list with secret rows filtered out.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AiParameter"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/ai/lookups/{lookupCode}/values": {
      "get": {
        "operationId": "aiLookupValues",
        "summary": "List values of a lookup category.",
        "description": "List the active-tenant values of the given lookup category. Returns id, code, name, sortOrder and isActive per value.",
        "x-ai-tool": {
          "sdkPath": "arda.platform.lookupValues",
          "domain": "platform",
          "kind": "read",
          "risk": "low",
          "timeoutMs": 3000,
          "keywords": [
            "platform",
            "lookup",
            "lookup values",
            "dictionary",
            "master data",
            "lookup",
            "danh mục",
            "từ điển dữ liệu",
            "liệt kê danh mục"
          ],
          "requiredPerms": [
            "platform.read"
          ],
          "service": "platform-service",
          "envelope": "result",
          "returns": "LookupValueList { items: [{ id, code, name, sortOrder, isActive }] }"
        },
        "parameters": [
          {
            "name": "lookupCode",
            "in": "path",
            "required": true,
            "x-ai-arg": "lookupCode",
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "description": "Lookup category code, at most 64 characters"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted lookup-value list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AiLookupValue"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/ai/calendar/status": {
      "get": {
        "operationId": "aiCalendarStatus",
        "summary": "Get the business calendar status.",
        "description": "Return the current business calendar state for the given branch: current, previous and next business dates plus the system-date status (OPEN, EOD_PROCESSING, CLOSED).",
        "x-ai-tool": {
          "sdkPath": "arda.platform.calendarStatus",
          "domain": "platform",
          "kind": "read",
          "risk": "low",
          "timeoutMs": 3000,
          "keywords": [
            "platform",
            "calendar",
            "business date",
            "system date",
            "working day",
            "eod",
            "calendar",
            "ngày làm việc",
            "ngày kế toán",
            "lịch hệ thống",
            "ngày nghỉ",
            "kết thúc ngày"
          ],
          "requiredPerms": [
            "platform.read"
          ],
          "service": "platform-service",
          "envelope": "result",
          "returns": "SystemDate { id, branch_code, current_business_date, previous_business_date, next_business_date, status, last_eod_at, updated_at }"
        },
        "parameters": [
          {
            "name": "branchCode",
            "in": "query",
            "x-ai-arg": "branchCode",
            "schema": {
              "type": "string",
              "maxLength": 64,
              "default": "HEAD_OFFICE"
            },
            "description": "Branch code; defaults to HEAD_OFFICE"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Business calendar status for the branch.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "$ref": "#/components/schemas/AiSystemDate"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AiOrganization": {
        "type": "object",
        "description": "Redacted organization exposed to the AI SDK. tenant_id and internal linkage fields (admin_unit_code, address) are dropped by the Platform handler and again by the response allowlist.",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parentId": {
            "type": "string"
          },
          "parentName": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "AiParameter": {
        "type": "object",
        "description": "Redacted parameter exposed to the AI SDK. Rows marked is_secret are filtered out entirely, so value only appears for non-secret parameters; tenant_id and scope_id are dropped.",
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "valueType": {
            "type": "string"
          },
          "scopeType": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "AiLookupValue": {
        "type": "object",
        "description": "Redacted lookup value exposed to the AI SDK. Internal linkage fields (category_id, metadata) are dropped.",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "sortOrder": {
            "type": "integer"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "AiSystemDate": {
        "type": "object",
        "description": "Business calendar state exposed to the AI SDK.",
        "properties": {
          "id": {
            "type": "string"
          },
          "branch_code": {
            "type": "string"
          },
          "current_business_date": {
            "type": "string",
            "format": "date-time"
          },
          "previous_business_date": {
            "type": "string",
            "format": "date-time"
          },
          "next_business_date": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "last_eod_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
