{
  "openapi": "3.1.0",
  "info": {
    "title": "Arda statistical internal AI surface",
    "version": "1.0.0",
    "description": "Operations the statistical service exposes to ai-service on /internal/ai/*. Signed service-to-service transport; the delegated subject (X-Tenant-Id) is forwarded by ai-service and re-validated by the statistical handler and repository. Only report metadata is exposed: raw report rows, query ids, param schemas and submission payloads are never reachable from this surface."
  },
  "paths": {
    "/internal/ai/report-definitions": {
      "get": {
        "operationId": "aiListReportDefinitions",
        "summary": "List active report definitions in the delegated tenant.",
        "description": "List active report definitions (danh mục báo cáo) in the active tenant. Returns id, code, name, group_code, output_format and is_active per definition, with pagination. Internal wiring (query_id, param_schema, template_file_id, actor ids, timestamps) is dropped by the handler and again by this response allowlist.",
        "x-ai-tool": {
          "sdkPath": "arda.statistical.listReportDefinitions",
          "domain": "statistical",
          "kind": "read",
          "risk": "low",
          "timeoutMs": 3000,
          "keywords": [
            "statistical",
            "report",
            "reports",
            "report definition",
            "report catalog",
            "output format",
            "list",
            "search",
            "báo cáo",
            "danh mục báo cáo",
            "biểu mẫu báo cáo",
            "thống kê",
            "định nghĩa báo cáo"
          ],
          "requiredPerms": [
            "statistical.read"
          ],
          "service": "statistical-service",
          "envelope": "result",
          "returns": "ReportDefinitionListPage { items: [{ id, code, name, group_code, output_format, is_active }], page, per_page, total }"
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "x-ai-arg": "search",
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Free-text filter on report code/name"
          },
          {
            "name": "page",
            "in": "query",
            "x-ai-arg": "cursor",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "One-based page number"
          },
          {
            "name": "per_page",
            "in": "query",
            "x-ai-arg": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            },
            "description": "Page size, 1-20"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted paginated report-definition page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AiReportDefinition"
                          }
                        },
                        "page": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/ai/indicators": {
      "get": {
        "operationId": "aiListIndicators",
        "summary": "List active statistical indicators in the delegated tenant.",
        "description": "List active statistical indicators (chỉ tiêu thống kê) in the active tenant. Returns id, code, name, unit, group_code and is_active per indicator, with pagination. Internal fields (tenant_id, created_by, timestamps) are dropped by the handler and again by this response allowlist.",
        "x-ai-tool": {
          "sdkPath": "arda.statistical.listIndicators",
          "domain": "statistical",
          "kind": "read",
          "risk": "low",
          "timeoutMs": 3000,
          "keywords": [
            "statistical",
            "indicator",
            "indicators",
            "metric",
            "kpi",
            "unit",
            "group",
            "list",
            "search",
            "chỉ tiêu",
            "chỉ tiêu thống kê",
            "thống kê",
            "đơn vị tính",
            "danh mục chỉ tiêu"
          ],
          "requiredPerms": [
            "statistical.read"
          ],
          "service": "statistical-service",
          "envelope": "result",
          "returns": "IndicatorListPage { items: [{ id, code, name, unit, group_code, is_active }], page, per_page, total }"
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "x-ai-arg": "search",
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Free-text filter on indicator code/name"
          },
          {
            "name": "page",
            "in": "query",
            "x-ai-arg": "cursor",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "One-based page number"
          },
          {
            "name": "per_page",
            "in": "query",
            "x-ai-arg": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            },
            "description": "Page size, 1-20"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted paginated indicator page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AiIndicator"
                          }
                        },
                        "page": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/ai/submissions": {
      "get": {
        "operationId": "aiListSubmissions",
        "summary": "List report submission statuses in the delegated tenant.",
        "description": "List report submission periods (trạng thái nộp báo cáo) in the active tenant, optionally narrowed by report_code, period_code and lifecycle status. Returns id, report_code, period_code, status and submitted_at per submission. The raw payload (report data), workflow case, submitter identity and internal timestamps are dropped by the handler and again by this response allowlist.",
        "x-ai-tool": {
          "sdkPath": "arda.statistical.listSubmissions",
          "domain": "statistical",
          "kind": "read",
          "risk": "low",
          "timeoutMs": 3000,
          "keywords": [
            "statistical",
            "submission",
            "submissions",
            "report submission",
            "period",
            "status",
            "approved",
            "rejected",
            "list",
            "search",
            "nộp báo cáo",
            "trạng thái báo cáo",
            "kỳ báo cáo",
            "phê duyệt báo cáo",
            "thống kê"
          ],
          "requiredPerms": [
            "statistical.read"
          ],
          "service": "statistical-service",
          "envelope": "result",
          "returns": "SubmissionStatusListPage { items: [{ id, report_code, period_code, status, submitted_at }], page, per_page, total }"
        },
        "parameters": [
          {
            "name": "report_code",
            "in": "query",
            "x-ai-arg": "reportCode",
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Optional report code filter (substring match)"
          },
          {
            "name": "period_code",
            "in": "query",
            "x-ai-arg": "periodCode",
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Optional reporting period code filter (substring match, e.g. 2026-08)"
          },
          {
            "name": "status",
            "in": "query",
            "x-ai-arg": "status",
            "x-ai-transform": "upper",
            "schema": {
              "type": "string",
              "enum": [
                "DRAFT",
                "SUBMITTED",
                "APPROVED",
                "REJECTED"
              ]
            },
            "description": "Optional submission lifecycle status filter"
          },
          {
            "name": "page",
            "in": "query",
            "x-ai-arg": "cursor",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "One-based page number"
          },
          {
            "name": "per_page",
            "in": "query",
            "x-ai-arg": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            },
            "description": "Page size, 1-20"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted paginated submission-status page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AiSubmission"
                          }
                        },
                        "page": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/ai/report-run": {
      "get": {
        "operationId": "aiRunReport",
        "summary": "Run one catalogued report for a period in the delegated tenant.",
        "description": "Run one catalogued report (identified by its report_code, never by SQL) for a reporting period and return the computed rows. This is the natural-language routing target: the assistant picks a report code from the catalog plus a period/org parameter, and the service executes the parameterised builder. Internal wiring (query_id, sql text, param schema, tenant_id) is never exposed; the rows are read-model values.",
        "x-ai-tool": {
          "sdkPath": "arda.statistical.runReport",
          "domain": "statistical",
          "kind": "read",
          "risk": "low",
          "timeoutMs": 8000,
          "keywords": [
            "statistical", "report", "run report", "report result", "report data", "period",
            "báo cáo", "chạy báo cáo", "kết quả báo cáo", "số liệu báo cáo",
            "dư nợ", "tiền gửi", "nợ xấu", "huy động", "khách hàng", "thống kê"
          ],
          "requiredPerms": ["statistical.read"],
          "service": "statistical-service",
          "envelope": "result",
          "returns": "ReportRun { code, name, period_code, columns: [string], rows: [[any]], row_count }"
        },
        "parameters": [
          {
            "name": "report_code", "in": "query", "x-ai-arg": "reportCode", "required": true,
            "schema": { "type": "string", "maxLength": 128 },
            "description": "Report code from the report-definition catalog (e.g. LOAN_PORTFOLIO_SUMMARY)"
          },
          {
            "name": "period_code", "in": "query", "x-ai-arg": "periodCode", "required": true,
            "schema": { "type": "string", "maxLength": 7 },
            "description": "Reporting period as YYYY-MM"
          },
          {
            "name": "org_code", "in": "query", "x-ai-arg": "orgCode",
            "schema": { "type": "string", "maxLength": 128 },
            "description": "Optional org unit filter"
          },
          {
            "name": "tenant_id", "in": "query", "x-ai-scope": "tenant", "required": true,
            "schema": { "type": "string" },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Computed report rows.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "result": { "$ref": "#/components/schemas/AiReportRun" } }
                }
              }
            }
          }
        }
      }
    },
    "/internal/ai/indicator-results": {
      "get": {
        "operationId": "aiListIndicatorResults",
        "summary": "List stored computed indicator values for a period.",
        "description": "List the stored values of computed indicators (chỉ tiêu QCMS) for a reporting period, optionally narrowed to one indicator code. Only computed results are exposed: the declarative formula, sources and dimension configuration stay behind this boundary. The dimension key survives because it tells the assistant which slice a value covers.",
        "x-ai-tool": {
          "sdkPath": "arda.statistical.listIndicatorResults",
          "domain": "statistical",
          "kind": "read",
          "risk": "low",
          "timeoutMs": 3000,
          "keywords": [
            "statistical", "indicator", "indicator result", "kpi value", "metric value", "period",
            "chỉ tiêu", "giá trị chỉ tiêu", "kết quả chỉ tiêu", "chỉ số",
            "tỷ lệ nợ xấu", "kpi", "thống kê"
          ],
          "requiredPerms": ["statistical.read"],
          "service": "statistical-service",
          "envelope": "result",
          "returns": "IndicatorResultListPage { items: [{ indicator_code, name, unit, period_code, dimension_key, value, source }], page, per_page, total }"
        },
        "parameters": [
          {
            "name": "period_code", "in": "query", "x-ai-arg": "periodCode",
            "schema": { "type": "string", "maxLength": 7 },
            "description": "Reporting period as YYYY-MM (all periods when omitted)"
          },
          {
            "name": "indicator_code", "in": "query", "x-ai-arg": "indicatorCode",
            "schema": { "type": "string", "maxLength": 128 },
            "description": "Optional indicator code filter (e.g. 30020.02)"
          },
          {
            "name": "per_page", "in": "query", "x-ai-arg": "limit",
            "schema": { "type": "integer", "minimum": 1, "maximum": 20, "default": 10 },
            "description": "Page size, 1-20"
          },
          {
            "name": "tenant_id", "in": "query", "x-ai-scope": "tenant", "required": true,
            "schema": { "type": "string" },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Stored indicator values.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "items": { "type": "array", "items": { "$ref": "#/components/schemas/AiIndicatorResult" } },
                        "page": { "type": "integer" },
                        "per_page": { "type": "integer" },
                        "total": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AiReportDefinition": {
        "type": "object",
        "description": "Redacted report-definition metadata exposed to the AI SDK. query_id, param_schema, template_file_id, tenant_id, actor ids and timestamps are dropped by the handler and again by this response allowlist.",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "group_code": {
            "type": "string"
          },
          "output_format": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "AiIndicator": {
        "type": "object",
        "description": "Redacted indicator metadata exposed to the AI SDK. tenant_id, actor ids and timestamps are dropped by the handler and again by this response allowlist.",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "group_code": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "AiReportRun": {
        "type": "object",
        "description": "Assistant-facing report result. tenant_id, query_id, the SQL/param wiring and the report's internal timestamps are not part of this shape; only the catalog identity plus the computed rows.",
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "period_code": { "type": "string" },
          "columns": { "type": "array", "items": { "type": "string" } },
          "rows": { "type": "array", "items": { "type": "array" } },
          "row_count": { "type": "integer" }
        }
      },
      "AiIndicatorResult": {
        "type": "object",
        "description": "Assistant-facing computed indicator value. The declarative formula, sources and dimension configuration are dropped by the handler and again by this response allowlist.",
        "properties": {
          "indicator_code": { "type": "string" },
          "name": { "type": "string" },
          "unit": { "type": "string" },
          "period_code": { "type": "string" },
          "dimension_key": { "type": "string" },
          "value": { "type": "number" },
          "source": { "type": "string", "enum": ["COMPUTED", "MANUAL", "IMPORTED"] }
        }
      },
      "AiSubmission": {
        "type": "object",
        "description": "Redacted report-submission status exposed to the AI SDK. The raw payload (report data), workflow_case_id, submitted_by/created_by identities and internal timestamps are dropped by the handler and again by this response allowlist.",
        "properties": {
          "id": {
            "type": "string"
          },
          "report_code": {
            "type": "string"
          },
          "period_code": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "SUBMITTED",
              "APPROVED",
              "REJECTED"
            ]
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
