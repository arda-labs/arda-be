{
  "openapi": "3.1.0",
  "info": {
    "title": "Arda deposit internal AI surface",
    "version": "1.0.0",
    "description": "Operations the deposit service exposes to ai-service on /internal/ai/*. Signed service-to-service transport; delegated subject headers are forwarded by ai-service and re-validated by the deposit handler. Tenant scope is sourced from the verified actor scope, never from tool arguments. Responses are redacted by the handler and again by this response allowlist: tenant_id, internal row ids, org/workflow/journal linkage, raw transaction payloads and audit fields are never exposed."
  },
  "paths": {
    "/internal/ai/savings": {
      "get": {
        "operationId": "aiListDepositSavings",
        "summary": "List savings accounts in the delegated tenant.",
        "description": "List savings accounts in the active tenant and delegated org scope, newest open date first, with pagination. q narrows savings_code/customer_code; status is an exact uppercase match. Returns the redacted savings row (code, customer code, product, open/maturity dates, principal, accrued interest, currency, status) — tenant_id, internal row id, org/workflow/journal linkage and audit fields are never returned.",
        "x-ai-tool": {
          "sdkPath": "arda.deposit.listSavings",
          "domain": "deposit",
          "kind": "read",
          "risk": "medium",
          "timeoutMs": 3000,
          "keywords": [
            "deposit",
            "savings",
            "savings account",
            "passbook",
            "term deposit",
            "customer",
            "principal",
            "accrued interest",
            "maturity",
            "list",
            "search",
            "sổ tiết kiệm",
            "tiền gửi tiết kiệm",
            "tiền gửi có kỳ hạn",
            "danh sách sổ tiết kiệm",
            "số dư tiết kiệm",
            "lãi dự trả",
            "ngày đáo hạn"
          ],
          "requiredPerms": [
            "deposit.read"
          ],
          "service": "deposit-service",
          "envelope": "result",
          "returns": "DepositSavingsListPage { items: [{ savings_code, customer_code, product_code, open_date, maturity_date, principal_minor, accrued_minor, currency_code, status }], page, per_page, total }"
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "x-ai-arg": "search",
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Free-text filter on savings code or customer code"
          },
          {
            "name": "status",
            "in": "query",
            "x-ai-arg": "status",
            "x-ai-transform": "upper",
            "schema": {
              "type": "string",
              "maxLength": 32
            },
            "description": "Exact savings status filter (ACTIVE, SETTLED, MATURED, ...)"
          },
          {
            "name": "page",
            "in": "query",
            "x-ai-arg": "cursor",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "One-based page number"
          },
          {
            "name": "per_page",
            "in": "query",
            "x-ai-arg": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            },
            "description": "Page size, 1-20"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted paginated savings page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AiSavings"
                          }
                        },
                        "page": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/ai/savings/{code}": {
      "get": {
        "operationId": "aiGetDepositSavings",
        "summary": "Read one savings passbook and its recent movements.",
        "description": "Read one savings account by savings code. Returns the redacted savings row plus a bounded preview of the 20 newest transactions (type, amount, currency, date, status) and the total transaction count. tenant_id, internal row ids, journal/workflow linkage and audit fields are never returned.",
        "x-ai-tool": {
          "sdkPath": "arda.deposit.getSavingsDetail",
          "domain": "deposit",
          "kind": "read",
          "risk": "medium",
          "timeoutMs": 3000,
          "keywords": [
            "deposit",
            "savings",
            "savings account",
            "passbook",
            "savings detail",
            "transaction",
            "movement",
            "deposit history",
            "accrued interest",
            "get",
            "read",
            "chi tiết sổ tiết kiệm",
            "lịch sử giao dịch",
            "biến động số dư",
            "tiền gửi thêm",
            "rút tiền",
            "lãi đã trả"
          ],
          "requiredPerms": [
            "deposit.read"
          ],
          "service": "deposit-service",
          "envelope": "result",
          "returns": "DepositSavingsDetail { savings: { savings_code, customer_code, product_code, open_date, maturity_date, principal_minor, accrued_minor, currency_code, status }, transactions: [{ txn_type, amount_minor, currency_code, txn_date, status }], transaction_count }"
        },
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "x-ai-arg": "savingsCode",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Savings code from arda.deposit.listSavings (max 128 chars)"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted savings detail with a bounded transaction preview.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "$ref": "#/components/schemas/AiSavingsDetail"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/ai/interest-rates": {
      "get": {
        "operationId": "aiListDepositInterestRates",
        "summary": "List active savings interest-rate tiers in the delegated tenant.",
        "description": "List active deposit rate tiers, optionally narrowed to one product_code, newest effective date first, with pagination. Returns the redacted tier (product code, term months, method, denominator, rate, effective date, active flag) — tenant_id, row id and audit fields are never returned.",
        "x-ai-tool": {
          "sdkPath": "arda.deposit.listInterestRates",
          "domain": "deposit",
          "kind": "read",
          "risk": "medium",
          "timeoutMs": 3000,
          "keywords": [
            "deposit",
            "savings",
            "interest rate",
            "deposit rate",
            "savings rate",
            "rate tier",
            "term",
            "product",
            "list",
            "search",
            "lãi suất huy động",
            "lãi suất tiết kiệm",
            "biểu lãi suất",
            "lãi suất theo kỳ hạn",
            "sản phẩm tiền gửi",
            "danh sách lãi suất"
          ],
          "requiredPerms": [
            "deposit.read"
          ],
          "service": "deposit-service",
          "envelope": "result",
          "returns": "DepositInterestRateListPage { items: [{ product_code, term_months, method, denominator, rate, effective_from, is_active }], page, per_page, total }"
        },
        "parameters": [
          {
            "name": "product_code",
            "in": "query",
            "x-ai-arg": "productCode",
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Savings product code to narrow the tiers (also matches the default/global tier)"
          },
          {
            "name": "page",
            "in": "query",
            "x-ai-arg": "cursor",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "One-based page number"
          },
          {
            "name": "per_page",
            "in": "query",
            "x-ai-arg": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            },
            "description": "Page size, 1-20"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted paginated interest-rate page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AiDepositRate"
                          }
                        },
                        "page": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AiSavings": {
        "type": "object",
        "description": "Redacted savings account exposed to the AI SDK. tenant_id, internal row id, org_code, workflow_case_id, journal_entry_id, created_by and timestamps are dropped by the deposit handler and again by this response allowlist. customer_code is a bank reference code, not raw PII.",
        "properties": {
          "savings_code": {
            "type": "string"
          },
          "customer_code": {
            "type": "string"
          },
          "product_code": {
            "type": "string"
          },
          "open_date": {
            "type": "string"
          },
          "maturity_date": {
            "type": "string"
          },
          "principal_minor": {
            "type": "integer"
          },
          "accrued_minor": {
            "type": "integer"
          },
          "currency_code": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "AiSavingsTxn": {
        "type": "object",
        "description": "Redacted savings transaction preview row. Internal ids, savings_id, workflow/journal linkage and audit fields are dropped by the deposit handler and again by this response allowlist.",
        "properties": {
          "txn_type": {
            "type": "string"
          },
          "amount_minor": {
            "type": "integer"
          },
          "currency_code": {
            "type": "string"
          },
          "txn_date": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "AiSavingsDetail": {
        "type": "object",
        "description": "Redacted savings detail: one AiSavings row, at most 20 newest AiSavingsTxn rows and the total transaction count.",
        "properties": {
          "savings": {
            "$ref": "#/components/schemas/AiSavings"
          },
          "transactions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AiSavingsTxn"
            }
          },
          "transaction_count": {
            "type": "integer"
          }
        }
      },
      "AiDepositRate": {
        "type": "object",
        "description": "Redacted deposit interest-rate tier exposed to the AI SDK. tenant_id, row id and audit fields are dropped by the deposit handler and again by this response allowlist.",
        "properties": {
          "product_code": {
            "type": "string"
          },
          "term_months": {
            "type": "integer"
          },
          "method": {
            "type": "string"
          },
          "denominator": {
            "type": "integer"
          },
          "rate": {
            "type": "number"
          },
          "effective_from": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
