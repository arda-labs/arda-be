{
  "openapi": "3.1.0",
  "info": {
    "title": "Arda capital internal AI surface",
    "version": "1.0.0",
    "description": "Operations the capital service exposes to ai-service on /internal/ai/*. Signed service-to-service transport; delegated subject headers (X-Tenant-Id, X-Org-Id, X-User-Org-Ids) are forwarded by ai-service and re-validated by the capital handler and repository. Every response is a redacted allowlist: tenant_id, workflow/journal linkage, actor ids and timestamps are never exposed."
  },
  "paths": {
    "/internal/ai/fund-types": {
      "get": {
        "operationId": "aiListFundTypes",
        "summary": "List active capital fund types in the delegated tenant.",
        "description": "List active fund classifications (loại quỹ) in the active tenant. Returns id, code, name and is_active per fund type, with pagination. Internal fields (tenant_id, created_by, timestamps) are dropped by the handler and again by this response allowlist.",
        "x-ai-tool": {
          "sdkPath": "arda.capital.listFundTypes",
          "domain": "capital",
          "kind": "read",
          "risk": "low",
          "timeoutMs": 3000,
          "keywords": [
            "capital",
            "fund type",
            "fund types",
            "fund classification",
            "fund source",
            "list",
            "search",
            "loại quỹ",
            "loại vốn",
            "nguồn vốn",
            "quỹ",
            "danh mục",
            "danh sách loại quỹ"
          ],
          "requiredPerms": [
            "capital.read"
          ],
          "service": "capital-service",
          "envelope": "result",
          "returns": "FundTypeListPage { items: [{ id, code, name, is_active }], page, per_page, total }"
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "x-ai-arg": "search",
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Free-text filter on fund-type code/name"
          },
          {
            "name": "page",
            "in": "query",
            "x-ai-arg": "cursor",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "One-based page number"
          },
          {
            "name": "per_page",
            "in": "query",
            "x-ai-arg": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            },
            "description": "Page size, 1-20"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted paginated fund-type page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AiFundType"
                          }
                        },
                        "page": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/ai/products": {
      "get": {
        "operationId": "aiListProducts",
        "summary": "List active capital products (fund products) in the delegated tenant.",
        "description": "List active capital products (sản phẩm vốn) in the active tenant. Returns id, code, name, fund_type_code, term_months, interest_rate, currency_code and is_active per product, with pagination. Internal fields (tenant_id, created_by, timestamps) are dropped by the handler and again by this response allowlist.",
        "x-ai-tool": {
          "sdkPath": "arda.capital.listProducts",
          "domain": "capital",
          "kind": "read",
          "risk": "low",
          "timeoutMs": 3000,
          "keywords": [
            "capital",
            "product",
            "products",
            "fund product",
            "term",
            "interest rate",
            "list",
            "search",
            "sản phẩm",
            "sản phẩm vốn",
            "kỳ hạn",
            "lãi suất",
            "danh mục sản phẩm"
          ],
          "requiredPerms": [
            "capital.read"
          ],
          "service": "capital-service",
          "envelope": "result",
          "returns": "CapitalProductListPage { items: [{ id, code, name, fund_type_code, term_months, interest_rate, currency_code, is_active }], page, per_page, total }"
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "x-ai-arg": "search",
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Free-text filter on product code/name"
          },
          {
            "name": "page",
            "in": "query",
            "x-ai-arg": "cursor",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "One-based page number"
          },
          {
            "name": "per_page",
            "in": "query",
            "x-ai-arg": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            },
            "description": "Page size, 1-20"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted paginated capital-product page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AiCapitalProduct"
                          }
                        },
                        "page": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/ai/contracts": {
      "get": {
        "operationId": "aiListContracts",
        "summary": "List fund contracts in the delegated tenant and organization scope.",
        "description": "List fund contracts (hợp đồng vốn) in the active tenant, narrowed by the delegated organization scope. Returns contract economics (amount, interest_rate, currency_code), dates, status and business codes per contract, with pagination. Internal fields (tenant_id, workflow_case_id, journal_entry_id, created_by, timestamps) are dropped by the handler and again by this response allowlist.",
        "x-ai-tool": {
          "sdkPath": "arda.capital.listContracts",
          "domain": "capital",
          "kind": "read",
          "risk": "low",
          "timeoutMs": 3000,
          "keywords": [
            "capital",
            "contract",
            "contracts",
            "fund contract",
            "fund",
            "disbursement",
            "maturity",
            "interest rate",
            "amount",
            "status",
            "list",
            "search",
            "hợp đồng vốn",
            "hợp đồng",
            "nguồn vốn",
            "số tiền",
            "lãi suất",
            "đáo hạn",
            "trạng thái",
            "danh sách hợp đồng"
          ],
          "requiredPerms": [
            "capital.read"
          ],
          "service": "capital-service",
          "envelope": "result",
          "returns": "CapitalContractListPage { items: [{ id, contract_code, fund_type_code, product_code, counterparty_code, contract_date, maturity_date, amount_minor, interest_rate, currency_code, status, org_code }], page, per_page, total }"
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "x-ai-arg": "search",
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Free-text filter on contract code, counterparty code or fund-type code"
          },
          {
            "name": "status",
            "in": "query",
            "x-ai-arg": "status",
            "x-ai-transform": "upper",
            "schema": {
              "type": "string",
              "enum": [
                "PENDING_APPROVAL",
                "ACTIVE",
                "REJECTED",
                "CLOSED"
              ]
            },
            "description": "Optional contract lifecycle status filter"
          },
          {
            "name": "sort",
            "in": "query",
            "x-ai-arg": "sort",
            "schema": {
              "type": "string",
              "enum": [
                "contract_code",
                "contract_date"
              ]
            },
            "description": "Optional whitelisted sort column"
          },
          {
            "name": "order",
            "in": "query",
            "x-ai-arg": "order",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            },
            "description": "Sort direction, asc or desc"
          },
          {
            "name": "page",
            "in": "query",
            "x-ai-arg": "cursor",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "One-based page number"
          },
          {
            "name": "per_page",
            "in": "query",
            "x-ai-arg": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            },
            "description": "Page size, 1-20"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted paginated fund-contract page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AiCapitalContract"
                          }
                        },
                        "page": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AiFundType": {
        "type": "object",
        "description": "Redacted capital fund type exposed to the AI SDK. tenant_id, created_by and timestamps are dropped by the handler and again by this response allowlist.",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "AiCapitalProduct": {
        "type": "object",
        "description": "Redacted capital product exposed to the AI SDK. tenant_id, created_by and timestamps are dropped by the handler and again by this response allowlist.",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "fund_type_code": {
            "type": "string"
          },
          "term_months": {
            "type": "integer"
          },
          "interest_rate": {
            "type": "number"
          },
          "currency_code": {
            "type": "string"
          },
          "is_active": {
            "type": "boolean"
          }
        }
      },
      "AiCapitalContract": {
        "type": "object",
        "description": "Redacted fund contract exposed to the AI SDK. tenant_id, workflow_case_id, journal_entry_id, created_by, updated_by and timestamps are dropped by the handler and again by this response allowlist; counterparty_code is a business code, never a person name or account number.",
        "properties": {
          "id": {
            "type": "string"
          },
          "contract_code": {
            "type": "string"
          },
          "fund_type_code": {
            "type": "string"
          },
          "product_code": {
            "type": "string"
          },
          "counterparty_code": {
            "type": "string"
          },
          "contract_date": {
            "type": "string",
            "format": "date"
          },
          "maturity_date": {
            "type": "string",
            "format": "date"
          },
          "amount_minor": {
            "type": "integer"
          },
          "interest_rate": {
            "type": "number"
          },
          "currency_code": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING_APPROVAL",
              "ACTIVE",
              "REJECTED",
              "CLOSED"
            ]
          },
          "org_code": {
            "type": "string"
          }
        }
      }
    }
  }
}
