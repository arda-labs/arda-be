{
  "openapi": "3.1.0",
  "info": {
    "title": "Arda HRM internal AI surface",
    "version": "1.0.0",
    "description": "Operations the HRM service exposes to ai-service on /internal/ai/*. Signed service-to-service transport; delegated subject headers are forwarded by ai-service and re-validated by the HRM handler/middleware."
  },
  "paths": {
    "/internal/ai/employees": {
      "get": {
        "operationId": "aiListEmployees",
        "summary": "List employees in the delegated tenant directory.",
        "description": "List employees in the active tenant's HR directory. Returns id, employeeCode, fullName, status per employee, with pagination.",
        "x-ai-tool": {
          "sdkPath": "arda.hrm.listEmployees",
          "domain": "hrm",
          "kind": "read",
          "risk": "medium",
          "timeoutMs": 3000,
          "keywords": ["hrm", "employee", "employees", "staff", "personnel", "list", "directory", "search", "hr"],
          "requiredPerms": ["hrm.read"],
          "service": "hrm-service",
          "envelope": "result",
          "returns": "EmployeeListPage { items: [{ id, employeeCode, fullName, status }], page, perPage, total }"
        },
        "parameters": [
          { "name": "q", "in": "query", "x-ai-arg": "search", "schema": { "type": "string", "maxLength": 128 }, "description": "Free-text filter on employee code/full name" },
          { "name": "status", "in": "query", "x-ai-arg": "status", "x-ai-transform": "upper", "schema": { "type": "string", "enum": ["ACTIVE", "PROBATION", "INACTIVE"] }, "description": "Filter by employment status" },
          { "name": "page", "in": "query", "x-ai-arg": "cursor", "schema": { "type": "integer", "minimum": 1, "default": 1 }, "description": "One-based page number" },
          { "name": "per_page", "in": "query", "x-ai-arg": "limit", "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 20 }, "description": "Page size, 1-50" },
          { "name": "tenant_id", "in": "query", "x-ai-scope": "tenant", "required": true, "schema": { "type": "string" }, "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments." }
        ],
        "responses": {
          "200": {
            "description": "Redacted paginated employee directory page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": { "$ref": "#/components/schemas/AiEmployee" }
                        },
                        "page": { "type": "integer" },
                        "perPage": { "type": "integer" },
                        "total": { "type": "integer" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AiEmployee": {
        "type": "object",
        "description": "Redacted employee exposed to the AI SDK. Internal linkage fields (tenant_id, org/position/job-title refs, iam_user_id) are dropped by the HRM handler and again by the response allowlist.",
        "properties": {
          "id": { "type": "string" },
          "employeeCode": { "type": "string" },
          "fullName": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
