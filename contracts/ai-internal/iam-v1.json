{
  "openapi": "3.1.0",
  "info": {
    "title": "Arda IAM internal AI surface",
    "version": "1.0.0",
    "description": "Operations the IAM service exposes to ai-service on /internal/ai/*. Signed service-to-service transport; delegated subject headers are forwarded by ai-service and re-validated by the IAM handler."
  },
  "paths": {
    "/internal/ai/users": {
      "get": {
        "operationId": "aiListUsers",
        "summary": "List directory users in the delegated tenant (admin read).",
        "description": "List users in the active tenant's directory (admin). Returns id, username, email, name, status, roles per user, with pagination.",
        "x-ai-tool": {
          "sdkPath": "arda.iam.listUsers",
          "domain": "iam",
          "kind": "read",
          "risk": "medium",
          "timeoutMs": 3000,
          "keywords": [
            "iam",
            "user",
            "users",
            "list",
            "directory",
            "account",
            "member",
            "staff",
            "admin",
            "search"
          ],
          "requiredPerms": [
            "iam.user.read"
          ],
          "service": "iam-service",
          "envelope": "result",
          "returns": "UserListPage { items: [{ id, username, email, name, status, roles }], total, page, perPage }"
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "x-ai-arg": "search",
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Free-text filter on username/email/name"
          },
          {
            "name": "status",
            "in": "query",
            "x-ai-arg": "status",
            "x-ai-transform": "upper",
            "schema": {
              "type": "string",
              "enum": [
                "ACTIVE",
                "SUSPENDED",
                "DISABLED",
                "PENDING"
              ]
            },
            "description": "Filter by status: ACTIVE, SUSPENDED, DISABLED, PENDING"
          },
          {
            "name": "size",
            "in": "query",
            "x-ai-arg": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            },
            "description": "Page size, 1-50"
          },
          {
            "name": "page",
            "in": "query",
            "x-ai-arg": "cursor",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "One-based page number"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted paginated user directory page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AiUserSummary"
                          }
                        },
                        "total": {
                          "type": "integer"
                        },
                        "page": {
                          "type": "integer"
                        },
                        "perPage": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AiUserSummary": {
        "type": "object",
        "description": "Redacted directory user exposed to the AI SDK. Sensitive fields (address, mobile, credentials) are dropped by the IAM handler and again by the response allowlist.",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}