{
  "openapi": "3.1.0",
  "info": {
    "title": "Arda Workflow internal AI surface",
    "version": "1.0.0",
    "description": "Operations the workflow service exposes to ai-service on /internal/ai/*. Signed service-to-service transport; delegated subject headers are forwarded by ai-service and re-validated by the workflow handler/middleware. Tenant identity always comes from the verified actor scope, never from tool arguments."
  },
  "paths": {
    "/internal/ai/work-items": {
      "get": {
        "operationId": "aiListWorkItems",
        "summary": "List workflow work items (work queues) in the delegated tenant.",
        "description": "List work items in the active tenant's incoming or outgoing work queue for the delegated user. Incoming items are filtered to what the user can claim, is assigned to, or created (maker track). Returns id, caseCode, caseType, taskType, stepCode, title, status, transactionStatus, slaStatus, slaDueAt, createdAt, updatedAt, canClaim, canOpen, canReassign per item, with pagination over the newest fetched window.",
        "x-ai-tool": {
          "sdkPath": "arda.workflow.listWorkItems",
          "domain": "workflow",
          "kind": "read",
          "risk": "medium",
          "timeoutMs": 3000,
          "keywords": [
            "workflow",
            "work item",
            "công việc",
            "việc của tôi",
            "task",
            "hàng đợi",
            "inbox",
            "giao dịch đến",
            "giao dịch đi",
            "cần xử lý",
            "sla"
          ],
          "requiredPerms": [
            "workflow.read"
          ],
          "service": "workflow-service",
          "envelope": "result",
          "returns": "WorkItemListPage { items: [{ id, caseCode, caseType, taskType, stepCode, title, status, transactionStatus, slaStatus, slaDueAt, createdAt, updatedAt, canClaim, canOpen, canReassign }], page, per_page, total }"
        },
        "parameters": [
          {
            "name": "direction",
            "in": "query",
            "x-ai-arg": "direction",
            "schema": {
              "type": "string",
              "enum": [
                "INCOMING",
                "OUTGOING"
              ],
              "default": "INCOMING"
            },
            "description": "Work queue direction; INCOMING (default) or OUTGOING. Search/ALL is not exposed to the assistant."
          },
          {
            "name": "status",
            "in": "query",
            "x-ai-arg": "status",
            "x-ai-transform": "upper",
            "schema": {
              "type": "string"
            },
            "description": "Filter by case transaction status (e.g. SUBMITTED, IN_REVIEW)"
          },
          {
            "name": "page",
            "in": "query",
            "x-ai-arg": "page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "One-based page number"
          },
          {
            "name": "per_page",
            "in": "query",
            "x-ai-arg": "perPage",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            },
            "description": "Page size, 1-20"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted paginated work-item page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AiWorkItem"
                          }
                        },
                        "page": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/ai/work-items/{itemId}": {
      "get": {
        "operationId": "aiGetWorkItem",
        "summary": "Read a single work item in the delegated tenant.",
        "description": "Read one work item by id in the active tenant. Returns the redacted work-item shape: id, caseCode, caseType, taskType, stepCode, title, status, transactionStatus, slaStatus, slaDueAt, createdAt, updatedAt, canClaim, canOpen, canReassign.",
        "x-ai-tool": {
          "sdkPath": "arda.workflow.getWorkItem",
          "domain": "workflow",
          "kind": "read",
          "risk": "medium",
          "timeoutMs": 3000,
          "keywords": [
            "workflow",
            "work item",
            "công việc",
            "task",
            "chi tiết",
            "xem việc",
            "sla",
            "trạng thái"
          ],
          "requiredPerms": [
            "workflow.read"
          ],
          "service": "workflow-service",
          "envelope": "result",
          "returns": "AiWorkItem { id, caseCode, caseType, taskType, stepCode, title, status, transactionStatus, slaStatus, slaDueAt, createdAt, updatedAt, canClaim, canOpen, canReassign }"
        },
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "x-ai-arg": "workItemId",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Workflow work item identifier (max 128 chars)"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted work item.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "$ref": "#/components/schemas/AiWorkItem"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/ai/cases": {
      "get": {
        "operationId": "aiListCases",
        "summary": "List business cases in the delegated tenant.",
        "description": "List business cases in the active tenant, optionally filtered by status and a keyword matched against case code, title and primary object id. Returns id, caseCode, caseType, status, title, createdAt, updatedAt per case, with pagination over the newest fetched window.",
        "x-ai-tool": {
          "sdkPath": "arda.workflow.listCases",
          "domain": "workflow",
          "kind": "read",
          "risk": "medium",
          "timeoutMs": 3000,
          "keywords": [
            "workflow",
            "case",
            "hồ sơ",
            "business case",
            "quy trình",
            "tìm hồ sơ",
            "danh sách hồ sơ",
            "tra cứu"
          ],
          "requiredPerms": [
            "workflow.read"
          ],
          "service": "workflow-service",
          "envelope": "result",
          "returns": "CaseListPage { items: [{ id, caseCode, caseType, status, title, createdAt, updatedAt }], page, per_page, total }"
        },
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "x-ai-arg": "status",
            "x-ai-transform": "upper",
            "schema": {
              "type": "string"
            },
            "description": "Filter by case status (e.g. SUBMITTED, IN_REVIEW, COMPLETED)"
          },
          {
            "name": "keyword",
            "in": "query",
            "x-ai-arg": "keyword",
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Free-text filter on case code, title and primary object id (max 128 chars)"
          },
          {
            "name": "page",
            "in": "query",
            "x-ai-arg": "page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "One-based page number"
          },
          {
            "name": "per_page",
            "in": "query",
            "x-ai-arg": "perPage",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            },
            "description": "Page size, 1-20"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted paginated case page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AiBusinessCase"
                          }
                        },
                        "page": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/ai/cases/{caseId}": {
      "get": {
        "operationId": "aiGetCase",
        "summary": "Read a single business case in the delegated tenant.",
        "description": "Read one business case by id in the active tenant. Returns the redacted case shape: id, caseCode, caseType, status, title, createdAt, updatedAt.",
        "x-ai-tool": {
          "sdkPath": "arda.workflow.getCase",
          "domain": "workflow",
          "kind": "read",
          "risk": "medium",
          "timeoutMs": 3000,
          "keywords": [
            "workflow",
            "case",
            "hồ sơ",
            "chi tiết hồ sơ",
            "xem hồ sơ",
            "trạng thái hồ sơ"
          ],
          "requiredPerms": [
            "workflow.read"
          ],
          "service": "workflow-service",
          "envelope": "result",
          "returns": "AiBusinessCase { id, caseCode, caseType, status, title, createdAt, updatedAt }"
        },
        "parameters": [
          {
            "name": "caseId",
            "in": "path",
            "x-ai-arg": "caseId",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Business case identifier (max 128 chars)"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted business case.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "$ref": "#/components/schemas/AiBusinessCase"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/ai/cases/{caseId}/timeline": {
      "get": {
        "operationId": "aiCaseTimeline",
        "summary": "Read the status timeline of a business case in the delegated tenant.",
        "description": "Read the timeline events of one business case in the active tenant, ordered oldest first. Returns id, eventType, createdAt per event; raw event data, actor identities and notes are dropped.",
        "x-ai-tool": {
          "sdkPath": "arda.workflow.caseTimeline",
          "domain": "workflow",
          "kind": "read",
          "risk": "medium",
          "timeoutMs": 3000,
          "keywords": [
            "workflow",
            "timeline",
            "lịch sử",
            "lịch sử hồ sơ",
            "tiến trình",
            "case history",
            "hồ sơ"
          ],
          "requiredPerms": [
            "workflow.read"
          ],
          "service": "workflow-service",
          "envelope": "result",
          "returns": "TimelinePage { items: [{ id, eventType, createdAt }], page, per_page, total }"
        },
        "parameters": [
          {
            "name": "caseId",
            "in": "path",
            "x-ai-arg": "caseId",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 128
            },
            "description": "Business case identifier (max 128 chars)"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted case timeline page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AiTimelineEvent"
                          }
                        },
                        "page": {
                          "type": "integer"
                        },
                        "per_page": {
                          "type": "integer"
                        },
                        "total": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AiWorkItem": {
        "type": "object",
        "description": "Redacted work item exposed to the AI SDK. Internal linkage and sensitive fields (tenant_id, description, summary, candidate users/group/org-unit, assignedTo/createdBy identity, previous assignee, process/job keys, claim expiry, avatars) are dropped by the workflow handler and again by this response allowlist.",
        "properties": {
          "id": {
            "type": "string"
          },
          "caseCode": {
            "type": "string"
          },
          "caseType": {
            "type": "string"
          },
          "taskType": {
            "type": "string"
          },
          "stepCode": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "transactionStatus": {
            "type": "string"
          },
          "slaStatus": {
            "type": "string"
          },
          "slaDueAt": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "canClaim": {
            "type": "boolean"
          },
          "canOpen": {
            "type": "boolean"
          },
          "canReassign": {
            "type": "boolean"
          }
        }
      },
      "AiBusinessCase": {
        "type": "object",
        "description": "Redacted business case exposed to the AI SDK. Internal linkage fields (tenant_id, process instance, bpmn refs, createdBy/assignedTo/candidateRole) are dropped by the workflow handler and again by this response allowlist.",
        "properties": {
          "id": {
            "type": "string"
          },
          "caseCode": {
            "type": "string"
          },
          "caseType": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        }
      },
      "AiTimelineEvent": {
        "type": "object",
        "description": "Redacted timeline event exposed to the AI SDK. The raw data JSON blob, actor identity, from/to statuses and notes are dropped by the workflow handler and again by this response allowlist.",
        "properties": {
          "id": {
            "type": "integer"
          },
          "eventType": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        }
      }
    }
  }
}
