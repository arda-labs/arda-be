{
  "openapi": "3.1.0",
  "info": {
    "title": "Arda Notification internal AI surface",
    "version": "1.0.0",
    "description": "Operations the Notification service exposes to ai-service on /internal/ai/*. Signed service-to-service transport; delegated subject headers are forwarded by ai-service and re-validated by the Notification handler/middleware. Inbox items are redacted: the free-form params map never leaves the service."
  },
  "paths": {
    "/internal/ai/notifications": {
      "get": {
        "operationId": "aiListInbox",
        "summary": "List the delegated user's notification inbox.",
        "description": "List recent inbox notifications for the delegated user (X-User-Id / X-User-Subject) within the active tenant. Returns id, type, titleKey, bodyKey, href, readAt and createdAt per item, newest first. The params map is redacted.",
        "x-ai-tool": {
          "sdkPath": "arda.notification.listInbox",
          "domain": "notification",
          "kind": "read",
          "risk": "low",
          "timeoutMs": 3000,
          "keywords": [
            "notification",
            "notifications",
            "inbox",
            "message",
            "alert",
            "unread",
            "thong bao",
            "thông báo",
            "hộp thư",
            "hộp thư đến",
            "tin nhắn",
            "chưa đọc",
            "thông báo mới"
          ],
          "requiredPerms": [
            "notification.read"
          ],
          "service": "notification-service",
          "envelope": "result",
          "returns": "InboxPage { items: [{ id, type, titleKey, bodyKey, href, readAt, createdAt }] }"
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "x-ai-arg": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            },
            "description": "Maximum number of inbox items, 1-20"
          },
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Redacted notification inbox for the delegated user.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "items": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/AiInboxItem"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/internal/ai/notifications/unread-count": {
      "get": {
        "operationId": "aiUnreadCount",
        "summary": "Count the delegated user's unread notifications.",
        "description": "Return the number of unread inbox notifications for the delegated user within the active tenant.",
        "x-ai-tool": {
          "sdkPath": "arda.notification.unreadCount",
          "domain": "notification",
          "kind": "read",
          "risk": "low",
          "timeoutMs": 3000,
          "keywords": [
            "notification",
            "notifications",
            "unread",
            "count",
            "badge",
            "thong bao",
            "thông báo",
            "chưa đọc",
            "số lượng thông báo",
            "đếm thông báo"
          ],
          "requiredPerms": [
            "notification.read"
          ],
          "service": "notification-service",
          "envelope": "result",
          "returns": "UnreadCount { count: number }"
        },
        "parameters": [
          {
            "name": "tenant_id",
            "in": "query",
            "x-ai-scope": "tenant",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Delegated tenant; sourced from the verified actor scope, never from tool arguments."
          }
        ],
        "responses": {
          "200": {
            "description": "Unread notification count for the delegated user.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "object",
                      "properties": {
                        "count": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AiInboxItem": {
        "type": "object",
        "description": "Redacted inbox notification exposed to the AI SDK. The free-form params map (personal data) and internal linkage fields (tenant_id, user_id) are dropped by the Notification handler and again by the response allowlist.",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "titleKey": {
            "type": "string"
          },
          "bodyKey": {
            "type": "string"
          },
          "href": {
            "type": "string"
          },
          "readAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
